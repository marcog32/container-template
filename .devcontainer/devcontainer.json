{
  "name": "isolated-devcontainer-template",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  "remoteUser": "vscode",
  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW"
  ],
  "mounts": [
    "source=claude-code-config-${devcontainerId},target=/home/vscode/.claude,type=volume",
    "source=project-ssh-${devcontainerId},target=/home/vscode/.ssh,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  },
  "postCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.claude /home/vscode/.ssh && chmod 700 /home/vscode/.ssh && sudo apt-get update && sudo apt-get install -y iptables ipset jq dnsutils aggregate",
  "postStartCommand": "sudo bash ${containerWorkspaceFolder}/.devcontainer/init-firewall.sh",
  "waitFor": "postStartCommand"
}